# Keep Unix line endings for files that run inside the container,
# even when the repo is checked out or copied on Windows.
*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.md        text eol=lf
*.svg       text eol=lf
